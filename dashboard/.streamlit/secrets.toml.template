# Streamlit Cloud Secrets Template
# ─────────────────────────────────
# On Streamlit Community Cloud:
#   App → Settings → Secrets → paste this (with your real values)
#
# For local dev, create this file at: dashboard/.streamlit/secrets.toml

AWS_ACCESS_KEY_ID     = "YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
AWS_DEFAULT_REGION    = "us-east-1"
DATA_LAKE_BUCKET      = "ai-feedback-platform-data-lake-YOUR_ACCOUNT_ID"
